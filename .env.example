# ---------------------------------------------------------------------------
# Biến môi trường cho docker-compose.yml
# Sao chép thành .env rồi đổi giá trị:   cp .env.example .env
# KHÔNG commit file .env lên Git.
# ---------------------------------------------------------------------------

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password

# Tài khoản ứng dụng dùng chung cho các service.
# Giữ DB_USERNAME=wms để khớp với docker/mysql/init.sql
DB_USERNAME=wms
DB_PASSWORD=change_me_wms_password

# --- JWT ---
# Khóa ký JWT, tối thiểu 32 ký tự. Có thể tạo bằng: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters

# --- Gửi email (notification-service) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Tùy chọn: đổi cổng publish ra máy host khi bị trùng cổng ---
# FRONTEND_PORT=80
# MYSQL_PORT=3306
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Giới hạn tốc độ tại API Gateway (token bucket trên Redis, theo người dùng hoặc IP). Mặc định 20 request/giây,
# bùng nổ tối đa 40. Đặt RATE_LIMIT_ENABLED=false khi chạy kiểm thử tải.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REPLENISH_RATE=20
# RATE_LIMIT_BURST_CAPACITY=40
