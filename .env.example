# ---------------------------------------------------------------------------
# Biến môi trường cho docker-compose.yml
# Sao chép thành .env rồi đổi giá trị:   cp .env.example .env
# KHÔNG commit file .env lên Git.
# ---------------------------------------------------------------------------

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password

# Tài khoản ứng dụng dùng chung cho các service.
# Giữ DB_USERNAME=wms để khớp với docker/mysql/init.sql
DB_USERNAME=wms
DB_PASSWORD=change_me_wms_password

# --- JWT ---
# Khóa ký JWT, tối thiểu 32 ký tự. Có thể tạo bằng: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
# Kiểm tra JWT tại api-gateway và ở WebSocket /ws-wms. Mặc định false ở máy phát triển (production luôn bật).
# Đặt true khi cần thử phân quyền theo kho: gateway mới chuyển tiếp danh tính và danh sách kho của người dùng.
GATEWAY_JWT_ENABLED=false
# Khi bật kiểm tra JWT, token không có claim companyId bị trả 401 để người dùng đăng nhập lại.
GATEWAY_COMPANY_REQUIRED=true
# Doanh nghiệp dùng khi request không có header X-Company-Id (gateway tắt kiểm tra JWT hoặc gọi thẳng service).
# Chỉ dùng ở máy phát triển; trên máy chủ để rỗng (docs/MULTI_TENANT.md).
TENANT_DEFAULT_COMPANY_ID=1

# --- Gửi email cảnh báo tồn kho (notification-service, WMS-15.2) ---
# Để trống MAIL_HOST thì không gửi email, nội dung được ghi vào log của notification-service (dùng khi phát triển).
# Ví dụ Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD là Mật khẩu ứng dụng. Mailpit: localhost, 1025.
# MAIL_PORT trống thì dùng 587; MAIL_FROM trống thì dùng MAIL_USERNAME.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Thanh toán PayOS (auth-service, WMS-23.5a) ---
# Máy phát triển để PAYOS_MOCK=true: không gọi PayOS, nút thanh toán dẫn tới trang giả lập của hệ thống.
# Ba khóa lấy ở my.payos.vn (kênh thanh toán). Để trống ở đây, KHÔNG commit khóa thật, không gửi qua chat.
PAYOS_MOCK=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang kết quả thanh toán của frontend; để trống thì dùng http://localhost/payment/result
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# --- Kích hoạt doanh nghiệp và đặt lại mật khẩu qua email (auth-service, WMS-23.6) ---
# Địa chỉ giao diện dùng trong liên kết email; để trống thì compose dùng http://localhost.
APP_FRONTEND_URL=
# true (mặc định): doanh nghiệp mới phải bấm liên kết kích hoạt trong email. Chỉ đặt false trên máy phát triển không
# có mail; khi chưa cấu hình SMTP, notification-service vẫn ghi liên kết ra log để bấm thử.
REGISTRATION_REQUIRE_ACTIVATION=

# --- AI (ai-service, WMS-24.1) ---
# Máy phát triển để AI_MOCK=true: không gọi Claude, trả câu trả lời mẫu (vẫn tính lượt để thử giới hạn gói).
# Khóa Anthropic chỉ do tech lead đặt trên máy chủ. Để trống ở đây, KHÔNG commit khóa thật, không gửi qua chat.
# Thiếu khóa thì ai-service tự chạy giả lập dù AI_MOCK=false.
AI_MOCK=true
ANTHROPIC_API_KEY=
# Mô hình Claude và mức suy nghĩ (low, medium, high). Để trống thì dùng claude-sonnet-5-5 và low.
AI_MODEL=
AI_EFFORT=

# --- Tùy chọn: đổi cổng publish ra máy host khi bị trùng cổng ---
# FRONTEND_PORT=80
# MYSQL_PORT=3306
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Tài khoản RabbitMQ (broker và các service dùng chung). Mặc định guest/guest là đủ cho máy dev vì cổng chỉ mở trên
# 127.0.0.1. Broker chỉ tạo tài khoản này khi volume còn trống; đổi trên volume đã có dữ liệu xem docs/MESSAGING.md mục 6.
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# Giới hạn tốc độ tại API Gateway (token bucket trên Redis, theo người dùng hoặc IP). Mặc định 20 request/giây,
# bùng nổ tối đa 40. Đặt RATE_LIMIT_ENABLED=false khi chạy kiểm thử tải.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REPLENISH_RATE=20
# RATE_LIMIT_BURST_CAPACITY=40
# API key cho hệ thống ngoài (header X-Api-Key, chỉ đọc hàng hóa, tồn kho, đơn hàng): mặc định bật, mỗi key tối đa
# 20 request/giây (vượt thì 429).
# GATEWAY_API_KEY_ENABLED=true
# API_KEY_RATE_LIMIT_PER_SECOND=20
