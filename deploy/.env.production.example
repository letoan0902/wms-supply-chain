# ---------------------------------------------------------------------------
# Biến môi trường cho môi trường production (VPS Ubuntu, tên miền wms.toanmarket.me).
# Dùng cùng docker-compose.yml và deploy/docker-compose.prod.yml.
#
# Cách dùng trên VPS, tại thư mục gốc repository (ví dụ /opt/wms-supply-chain):
#   cp deploy/.env.production.example .env
#   chmod 600 .env
#   nano .env        # điền ACME_EMAIL và các mật khẩu còn trống
#
# KHÔNG commit file .env lên Git. File mẫu này không chứa bí mật thật.
#
# Sinh chuỗi ngẫu nhiên cho mật khẩu và khóa (chạy lệnh riêng cho từng giá trị để các giá trị khác nhau):
#   openssl rand -base64 32      # mật khẩu MySQL
#   openssl rand -base64 48      # JWT_SECRET
# Chuỗi base64 chỉ gồm chữ, số và các ký tự + / = nên dán thẳng vào file này, không cần đặt trong dấu nháy.
#
# LƯU Ý: MySQL chỉ đọc mật khẩu ở lần khởi tạo đầu tiên (khi volume mysql_data còn trống). Đổi
# MYSQL_ROOT_PASSWORD hoặc DB_PASSWORD về sau trong file này KHÔNG đổi mật khẩu bên trong MySQL,
# nên hãy đặt đúng giá trị ngay từ lần chạy đầu.
# ---------------------------------------------------------------------------

# --- Tên miền và HTTPS (Caddy) ---
# Bản ghi DNS A của tên miền phải trỏ về IP máy chủ (chế độ DNS only, không bật proxy Cloudflare)
# trước khi chạy deploy.sh để Caddy xin được chứng chỉ Let's Encrypt.
DOMAIN=wms.toanmarket.me
# Email đăng ký tài khoản Let's Encrypt. BẮT BUỘC, điền email thật của bạn.
ACME_EMAIL=

# --- MySQL ---
# Mật khẩu root của MySQL (dùng trong container mysql cho healthcheck và sao lưu)
MYSQL_ROOT_PASSWORD=
# Tài khoản ứng dụng dùng chung cho các service.
# Giữ DB_USERNAME=wms để khớp với docker/mysql/init.sql
DB_USERNAME=wms
DB_PASSWORD=

# --- JWT ---
# Khóa ký JWT, tối thiểu 32 ký tự, dùng chung cho api-gateway và auth-service.
JWT_SECRET=

# --- API Gateway ---
# Origin của giao diện web, phân tách bằng dấu phẩy nếu có nhiều origin. Phải khớp https://<DOMAIN>,
# nếu sai thì đăng nhập và các request POST/PUT/DELETE bị gateway từ chối (403).
CORS_ALLOWED_ORIGINS=https://wms.toanmarket.me
# Kiểm tra JWT tập trung tại gateway: mọi API (trừ /api/auth/login) cần Bearer token hợp lệ.
# Chỉ đặt false khi cần chẩn đoán sự cố, vì khi đó API nghiệp vụ không yêu cầu đăng nhập.
GATEWAY_JWT_ENABLED=true
# Giới hạn tốc độ (token bucket trên Redis, theo người dùng hoặc IP): mặc định 20 request/giây,
# bùng nổ tối đa 40. Muốn đổi ngưỡng, bỏ dấu # ở hai dòng bên dưới và sửa giá trị.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REPLENISH_RATE=20
# RATE_LIMIT_BURST_CAPACITY=40

# --- Gửi email (notification-service) ---
# Với Gmail, MAIL_PASSWORD là Mật khẩu ứng dụng (App Password), không phải mật khẩu đăng nhập Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Docker Compose ---
# Hai dòng dưới giúp mọi lệnh "docker compose" chạy trong thư mục này tự dùng cả docker-compose.yml lẫn
# deploy/docker-compose.prod.yml mà không cần gõ -f, tránh chạy nhầm chỉ file gốc (sẽ publish lại cổng 80 và 8080).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml

# Các biến đổi cổng publish (FRONTEND_PORT, MYSQL_PORT, REDIS_PORT, RABBITMQ_PORT, RABBITMQ_MANAGEMENT_PORT) trong
# .env.example chỉ dành cho máy phát triển: ở production cổng 80 và 443 thuộc về Caddy, còn frontend không publish cổng.
